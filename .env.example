# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=supabaseurl
NEXT_PUBLIC_SUPABASE_ANON_KEY=anonkey
# For server-side admin actions (optional but recommended):
SUPABASE_SERVICE_ROLE_KEY=servicerolekey
JUDGE0_URL=http://127.0.0.1:2358
# ── Code Execution ───────────────────────────────────────────
# NO API KEY NEEDED.
#
# Python + JavaScript run entirely in the user's browser via:
#   - Pyodide (CPython 3.11 compiled to WebAssembly)
#   - Web Workers (native browser sandboxing)
#
# C++ / Java / Go / Rust are compiled via Wandbox.org:
#   - 100% free, no account, no token required
#   - Called server-side from /api/execute

# ── UPI Payments ─────────────────────────────────────────────
# NO API KEY NEEDED.
# UPI ID is set per-contest in Admin Panel → Contests tab.
# Users see a QR code, pay on their UPI app, enter transaction ID.
# Admin verifies manually and confirms the registration.



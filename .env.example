# ── Self-Hosted Database (PostgreSQL 16) ─────────────────────
DATABASE_URL=postgresql://postgres:dhruvbitbybit@localhost:5432/bitbybit?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bitbybit
POSTGRES_PORT=5432

# ── Self-Hosted Cache & Rate Limiting (Redis 7) ──────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── GitHub OAuth & API Resolution ─────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_TOKEN=your-github-personal-access-token-for-etl

# ── Supabase (Source for Migration ETL) ──────────────────────
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Features (Groq + Fallback Ollama) ─────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_MODEL=qwen2.5-coder:3b

# ── Razorpay (Subscriptions & Payments) ──────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_WEBHOOK_SECRET=xxx
NEXT_PUBLIC_PAYMENTS_LIVE=true

# ── Brevo / SMTP (Transactional Emails & Certificates) ───────
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=support@yourdomain.com
BREVO_SENDER_NAME=BitByBit

# ── Code Execution & Judge0 ──────────────────────────────────
JUDGE0_URL=http://127.0.0.1:2358
CRON_SECRET=your-random-cron-secret
NEXT_PUBLIC_SITE_URL=https://yourdomain.com



